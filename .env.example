# DataDiverService Credentials - MANTENER CREDENCIALES ORIGINALES
DATADIVERSERVICE_USER=tu_usuario
DATADIVERSERVICE_PASS=tu_password

# Server Configuration
PORT=3030
NODE_ENV=production

# Puppeteer Configuration - OPTIMIZADO
MAX_CONCURRENT_PAGES=2              
PAGE_POOL_SIZE=2                    
QUEUE_TIMEOUT=90000

# Session Management - OPTIMIZADO PARA ACTIVIDAD AUTOMÁTICA INTELIGENTE
TOKEN_REFRESH_INTERVAL=480000       
ACTIVITY_INTERVAL=90000             
HEARTBEAT_INTERVAL=45000            
REAL_QUERY_INTERVAL=180000          
IDLE_ACTIVITY_INTERVAL=60000        
MAX_IDLE_TIME=30000                 

# Session Thresholds - CONSERVADORES
SESSION_CHECK_INTERVAL=300000       
PROACTIVE_LOGIN_THRESHOLD=900000    

# Logging
LOG_LEVEL=info
LOG_FILE=logs/scraper.log